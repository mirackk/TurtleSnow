{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turtlesnow",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "account_id": "43b5ffa383e06b416f11a0e935fe7b79",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "FORECASTS", "id": "e992f19c58074ecf879be71bf17062a7" }],
  "triggers": { "crons": ["0 * * * *"] }
}
